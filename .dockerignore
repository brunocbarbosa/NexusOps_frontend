# Contexto de build. Sem este arquivo o daemon recebe node_modules inteiro
# (centenas de MB) antes de qualquer instrução do Dockerfile rodar.
.git
.github
node_modules
.next
out
build
coverage
test-results
playwright-report
blob-report
